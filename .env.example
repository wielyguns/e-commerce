APP_NAME=JPBook
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# --- Octane ------------------------------------------------------------------
OCTANE_SERVER=frankenphp

# --- Database (read/write split) ---------------------------------------------
DB_CONNECTION=pgsql
DB_HOST=pgsql
DB_READ_HOST=pgsql-replica
DB_PORT=5432
DB_DATABASE=jpbook
DB_USERNAME=jpbook
DB_PASSWORD=secret
DB_REPLICATION_PASSWORD=replicasecret

# --- Stateless infra (everything in Redis) -----------------------------------
SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=redis
CACHE_PREFIX=jpbook

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

# --- Search (Laravel Scout + Meilisearch) ------------------------------------
SCOUT_DRIVER=meilisearch
SCOUT_QUEUE=true
MEILISEARCH_HOST=http://meilisearch:7700
MEILISEARCH_KEY=masterKeyChangeMe
MEILI_ENV=development

# --- Mail (queued) -----------------------------------------------------------
MAIL_MAILER=log
MAIL_FROM_ADDRESS="orders@jpbook.test"
MAIL_FROM_NAME="${APP_NAME}"

# --- Payment gateway: Midtrans (Phase D, sandbox by default) ------------------
PAYMENT_GATEWAY=midtrans
MIDTRANS_MERCHANT_ID=
MIDTRANS_CLIENT_KEY=
MIDTRANS_SERVER_KEY=
MIDTRANS_IS_PRODUCTION=false

# --- Shipping provider: Biteship (Phase C) ------------------------------------
SHIPPING_PROVIDER=biteship
BITESHIP_BASE_URL=https://api.biteship.com
BITESHIP_API_KEY=
SHIPPING_ORIGIN_AREA_ID=
SHIPPING_ORIGIN_POSTAL_CODE=

# --- WhatsApp notification (stub for now) ------------------------------------
WHATSAPP_ENABLED=false
WHATSAPP_API_URL=
WHATSAPP_API_TOKEN=

VITE_APP_NAME="${APP_NAME}"
